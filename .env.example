# ---------------------------------------------------------------
# Configuración de producción. Copiá este archivo a `.env` y completalo.
# (scripts/instalar.sh lo genera solo con contraseñas aleatorias.)
# ---------------------------------------------------------------

# Dominio con el que se accede (la app queda en https://DOMINIO/asistente-sistemas).
# (el dominio tiene que apuntar a la IP del VPS y los puertos 80/443 estar abiertos).
# Para probar sin dominio, usá  DOMAIN=:80  y entrá por http://IP-DEL-VPS/asistente-sistemas
DOMAIN=miplancober.com

# Base de datos (PostgreSQL corre en su propio contenedor, no se expone a internet)
POSTGRES_USER=pedidos
POSTGRES_PASSWORD=cambiame-por-una-clave-larga
POSTGRES_DB=pedidos

# Primer administrador: se crea solo la primera vez que arranca la app con la base vacía.
ADMIN_EMAIL=admin@tuempresa.com
ADMIN_PASSWORD=cambiame-tambien
ADMIN_NOMBRE=Administrador

# Opcional. Por defecto la cookie de sesión es "Secure" cuando se entra por HTTPS.
# COOKIE_SECURE=true

# Opcional. Puerto local del contenedor de la app (solo accesible desde el VPS).
# APP_PORT=3000
