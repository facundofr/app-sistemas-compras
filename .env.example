# ---------------------------------------------------------------
# Configuración de producción. Copiá este archivo a `.env` y completalo.
# (scripts/instalar.sh lo genera solo con contraseñas aleatorias.)
# ---------------------------------------------------------------

# Dominio con el que se accede (la app queda en https://DOMINIO/asistente-sistemas).
# (el dominio tiene que apuntar a la IP del VPS y los puertos 80/443 estar abiertos).
# Para probar sin dominio, usá  DOMAIN=:80  y entrá por http://IP-DEL-VPS/asistente-sistemas
DOMAIN=miplancober.com

# Base de datos (PostgreSQL corre en su propio contenedor, no se expone a internet)
POSTGRES_USER=pedidos
POSTGRES_PASSWORD=cambiame-por-una-clave-larga
POSTGRES_DB=pedidos

# Primer administrador: se crea solo la primera vez que arranca la app con la base vacía.
ADMIN_EMAIL=admin@tuempresa.com
ADMIN_PASSWORD=cambiame-tambien
ADMIN_NOMBRE=Administrador

# Opcional. Por defecto la cookie de sesión es "Secure" cuando se entra por HTTPS.
# COOKIE_SECURE=true

# Opcional. Puerto local del contenedor de la app (solo accesible desde el VPS).
# APP_PORT=3000

# ---------------------------------------------------------------
# Opcionales. Todo funciona sin esto; cada bloque activa una mejora.
# Se puede ver qué está activo en la app: Administración → Integraciones.
# ---------------------------------------------------------------

# Dirección pública de la app (para los links de los emails y para Mercado Libre).
# APP_URL=https://miplancober.com/asistente-sistemas

# Avisos por email (SMTP de Gmail, Microsoft 365, etc.).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=avisos@tuempresa.com
# SMTP_PASSWORD=contraseña-de-aplicacion
# SMTP_FROM="Pedidos Sistemas <avisos@tuempresa.com>"

# Notificaciones push al celular. Generar las claves una sola vez con:
#   npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:sistemas@tuempresa.com

# Mercado Libre: crear una aplicación en https://developers.mercadolibre.com.ar/devcenter
# con URL de redirección  APP_URL/api/mercadolibre/callback  (requiere APP_URL).
# ML_CLIENT_ID=
# ML_CLIENT_SECRET=

# Archivos en un almacenamiento compatible con S3 (Cloudflare R2, Backblaze B2, AWS) en vez del disco.
# Los que ya están en disco se pasan con: docker compose exec app node scripts/migrar-archivos-s3.mjs
# S3_BUCKET=
# S3_ENDPOINT=https://<cuenta>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Monitoreo de errores con Sentry (https://sentry.io).
# SENTRY_DSN=
